---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
@media (min-width: 600px) {
		.container {

			display: flex;
			flex-direction: row;
			gap: 10px;
		}

		.child-item {
  			align-self: center;
  		}
}
		img {
			max-height: 512px;
			max-width: 256px;
		}

		.profile-pic {
			max-width: 100px;
		}


		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Quality Band Repair and Instrument Rental</h1>
			<div class="container">
			<img class="child-item" src="/QualityBandRepair.jpg"/>
			<p class="child-item">
			
				I've been repairing Brass and Woodwind instruments since 2018 years and guitars, amps, microphones,
				and other rock music gear since 2024.  I've worked on more obscure instruments
				like accordions, banjos and even a church organ as well.
			</p>
			</div>
			<div class="container">
			<p class="child-item">
				Quality Band Repair's focus has always been on craftsmanship and quality over speed.  Work is done
				by appointment only, a diagnosis is free and hours are flexible.  
			</p>
			<img src="/FixinSax.jpg"  class="child-item" />
			</div>
			<div class="container">
				<div class="child-item"><img src="Tuba-Repair-2.jpg">
			<img src="/Shelves.jpg"  /></div>
				
			<div class="child-item">
			<p>Services:</p>
			<ul>
				<li>
					<strong>Instrument Rentals</strong>
				</li>
				<li>
					<strong>Instruments and Music Gear Sales</strong>
				</li>
					<li>
						<strong>Brass Instrument Cleaning and Repair</strong> Tuba, Trombone, Trumpet, French Horn, and all related brass instruments!
					</li>
					<li>
						<strong>Woodwind Instrument Cleaning and Repair</strong> Flute, Clarinet, Saxophones, Oboe, Bassoon, and all related instruments!
					</li>
					<li>
						<strong>Electric Instrument Cleaning and Repair</strong> Electric Guitar, Electric Bass, Electric Keyboards, Electric Violin and similar.
					</li>
					<li>
						<strong>Stringed Acoustic Instrument Cleaning and Repair</strong> Acoustic Guitar, Banjo, other similar instruments. (I do not yet work on violin/viola/cello/bass but I am learning)
					</li>
					<li>
						<strong>Percussion Cleaning and Repair</strong> Drums, cymbals, other similar percussion instruments.
					</li>
					<li>
						<strong>Music related electronic gear Cleaning and Repair</strong> Amplifiers, Microphones, Patch cables, PA Systems, some other types of electronic gear, just ask!
					</li>
					<li>
						<strong>Other:</strong> Accordion Cleaning and Repair.
					</li>
				</ul>
			</div>
			</div>
			<div class="container">
		
			<img class="profile-pic" src="/me.jpg"  class="child-item"/>	<p class="child-item"><a href="/contact">Contact Andrew</a></p>
			</div>
		</main>
		<Footer />
	</body>
</html>
